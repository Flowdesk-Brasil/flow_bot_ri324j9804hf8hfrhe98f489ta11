{
  "name": "flowdesk-launcher",
  "version": "5.0.0",
  "private": true,
  "description": "Flowdesk Launcher Pro",
  "author": "Flowdesk",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/generate-icons.js",
    "predist": "node scripts/generate-icons.js",
    "dist": "electron-builder --win nsis --x64 && node scripts/copy-dist.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "mysql2": "^3.24.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4"
  },
  "build": {
    "appId": "com.flowdesk.launcher",
    "productName": "Flowdesk Launcher Pro",
    "copyright": "Flowdesk",
    "artifactName": "FlowdeskLauncher-Setup.exe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "executor.js",
      "cityMysql.js",
      "cityHeal.js",
      "open-db-ports.cmd",
      "heal-mysql.cmd",
      "assets/**/*",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "open-db-ports.cmd",
        "to": "open-db-ports.cmd"
      },
      {
        "from": "heal-mysql.cmd",
        "to": "heal-mysql.cmd"
      }
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flowdesk Launcher",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "pt_BR",
        "en_US"
      ],
      "language": "1046",
      "unicode": true,
      "include": "installer.nsh"
    },
    "protocols": [
      {
        "name": "Flowdesk Launcher",
        "schemes": [
          "flowdesk-launcher"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Flowdesk-Brasil",
        "repo": "flow_bot_ri324j9804hf8hfrhe98f489ta11",
        "releaseType": "release"
      }
    ]
  }
}
